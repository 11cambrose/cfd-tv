{
  "name": "cfd-tv-qa",
  "private": true,
  "type": "module",
  "description": "CFD TV developer QA: schema check, broken-ID check, headless Chrome smoke",
  "scripts": {
    "validate": "node validate.mjs ..",
    "dst": "node dst-check.mjs ..",
    "smoke": "node smoke.mjs http://localhost:8000 --known known-fails.json",
    "smoke:blocked": "node smoke.mjs http://localhost:8000 --block-embeds --known known-fails.json"
  },
  "engines": { "node": ">=22 <23" },
  "dependencies": {
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "puppeteer-core": "23.11.1"
  }
}
