# CFD TV — environment for the data builders in build/ (the site itself needs no env).
# Copy to .env (gitignored) only if you need to override defaults. No secrets live here.

# Site root the builders read verify/ from and write channels.json + data/highlights.json into.
# Default: the repo root.
CFD_TV_SITE=

# Where the source exports live, ':'-separated search path (like $PATH). Default: ./data/sources
# Files looked up by name: SPOTIFY-11BROSE-INVENTORY.json, DJ-BROSE-DICE-2026-09-24.json,
# 11brose-stories-dates-2026-10-03.csv, brose-almanac-thread-2026-10-03.csv,
# evergreen-reshare-ig-links-2026-10-03.csv, TCZ-ARCHIVE-INDEX.csv,
# tcz-birthday-codes-2026-10-03.csv, tcz-published-bodies-2026-10-03.json
# On the Grok Bot box:
#   CFD_DATA_DIR=/workspace/artifacts:/workspace/artifacts/ledgers:/workspace/research/products/dj-brose-radio:/workspace/cfd-charge
CFD_DATA_DIR=

# Scratch dir for downloaded YouTube channel pages. Default: ./build/.cache
CFD_TMP_DIR=

# Date stamp in verify/ file names (yt-verified-<date>.json, yt-oembed-<date>.json, spotify-oembed-<date>.json).
CFD_VERIFY_DATE=2026-10-06
